# Gateway SDK connection settings
GATEWAY_URL=http://127.0.0.1:8800
GATEWAY_SECRET=replace-with-your-gateway-secret
GATEWAY_SECRET_VERSION=1
GATEWAY_TIMEOUT=60.0

# Optional legacy compatibility only. Do not set per-provider tokens when
# using Gateway's automatic catalog and X-Provider-Name routing.
# ROUTE_TOKEN_<PROVIDER>=legacy-route-token
